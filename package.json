{
  "name": "wx-scope",
  "private": true,
  "version": "0.2.0",
  "description": "Desktop PPI weather radar with live lightning and street map",
  "author": "WX-SCOPE",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "node electron/dev.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && node scripts/pack-win.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.wxscope.desktop",
    "productName": "WX-SCOPE",
    "files": [
      "dist/**/*",
      "electron/main.mjs",
      "build/icon.ico",
      "build/icon.png"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
